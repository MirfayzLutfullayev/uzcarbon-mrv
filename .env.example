# Nusxa oling: .env.example -> .env, keyin qiymatlarni to'ldiring.
PORT=3000

# AI-yordamchi uchun (ixtiyoriy). Kalitni https://console.anthropic.com dan oling.
# Bo'sh qoldirilsa, platforma AI-yordamchisiz ishlaydi (hisob-kitob va statistik tahlil ishlayveradi).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
