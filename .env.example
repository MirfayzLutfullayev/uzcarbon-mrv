# Nusxa oling: .env.example -> .env, keyin qiymatlarni to'ldiring.
PORT=3000

# Ma'lumotlar bazasi (standart: data/uzcarbon.db)
# DB_FILE=

# Xavfsizlik
MFA_ENFORCE=1            # administratorlar, verifikator va IMV uchun 2FA majburiy (0 — o'chirish, faqat sinov uchun)
SESSION_TTL_HOURS=8
SECURE_COOKIES=0         # HTTPS orqasida ishlaganda 1
# SIGNING_KEY=           # berilmasa data/signing.key avtomatik yaratiladi
# PUBLIC_URL=https://uzcarbon.example.uz   # importyorga ulashish havolalari uchun

# Normativ yordamchi (AI-8) uchun tashqi LLM. TZ talabi: tijorat siri tashqi xizmatga yuborilmaydi —
# faqat buyurtmachining yozma roziligi bilan yoqiladi. O'chiq bo'lsa, yordamchi manbali parchalarni qaytaradi.
AI_EXTERNAL_ALLOWED=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
