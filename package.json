{
  "name": "uzcarbon-mrv",
  "version": "0.2.0",
  "description": "UZ-Carbon MRV — eksportyorlar uchun IG emissiyalari, milliy uglerod narxi va CBAM to'lovini hisoblash, monitoring va tahlil platformasi",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node scripts/ensure-seed.js && node server.js",
    "start:bare": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "seed": "node scripts/seed-demo.js --force",
    "totp": "node scripts/totp.js",
    "legacy": "node legacy/server.js",
    "test:legacy": "node --test legacy/tests/"
  },
  "engines": {
    "node": ">=22.13"
  }
}
